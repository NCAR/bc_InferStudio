#!/usr/bin/env bash
echo "Starting InferStudio..."

# When the job's wall time runs out (Unix seconds). InferStudio counts down
# to it in the page header and warns before the job is killed.
export INFERSTUDIO_JOB_END=$(( $(date +%s) + <%= context.bc_num_hours.to_i %> * 3600 ))

#module restore
module load ncarenv/25.10 cuda/12.9.0 conda

CONDA_SETUP_FILE="${NCAR_JUPYTERHUB_PREFIX}/stable/etc/profile.d/conda.sh"
[ -f ${CONDA_SETUP_FILE} ] && . ${CONDA_SETUP_FILE}
conda activate /glade/work/pearse/conda-envs/creditJun3

cd /glade/work/pearse/InferStudio

set -x
panel serve panel_app.py \
    --port ${port} \
    --address 0.0.0.0 \
    --prefix "${INFERSTUDIO_PREFIX}" \
    --allow-websocket-origin="*"
