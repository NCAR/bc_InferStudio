---
# Sessions run on Casper only: they need no GPU, and InferStudio submits its
# inference jobs to Casper or Derecho from there. (A CPU-only session on
# Derecho would be charged for a whole node.)
cluster:
  - "casper"
form:
  - resource
  - custom_queue
  - bc_account
  - num_nodes
  - bc_num_slots
  - threads
  - mpiprocs
  - memory
  - bc_num_hours
  - conda_env
  - bc_email_on_started
attributes:
  resource:
    label: 'Resource Selection'
    widget: 'select'
    help: |
      The session itself runs on CPUs only. Run Inference submits a
      separate GPU job, to Casper or Derecho, charged to this account.
      New to InferStudio? See the
      [Quickstart](https://inferstudio.readthedocs.io/en/latest/getting-started/quickstart.html)
      or the [full documentation](https://inferstudio.readthedocs.io/).
    options:
      # - [ 'Casper login', 'jhublogin',
      #     data-exclusive-option-for-cluster-casper: true,
      #     data-hide-custom-queue: true,
      #     data-set-custom-queue: 'jhublogin',
      #     data-hide-num-nodes: true,
      #     data-set-num-nodes: 1,
      #     data-hide-bc-num-slots: true,
      #     data-set-bc-num-slots: 2,
      #     data-hide-threads: true,
      #     data-set-threads: 1,
      #     data-hide-mpiprocs: true,
      #     data-set-mpi-procs: 1,
      #     data-hide-memory: true,
      #     data-set-memory: 10,
      #     data-hide-bc-num-hours: true,
      #     data-set-bc-num-hours: 720,
      #     data-max-bc-num-hours: 720,
      #     data-hide-conda-env: true,
      #     data-set-conda-env: '/glade/work/pearse/conda-envs/creditJun3' ]
      - [ 'Casper PBS batch', 'casper_batch',
          data-exclusive-option-for-cluster-casper: true,
          data-set-custom-queue: 'casper',
          data-hide-custom-queue: true,
          data-set-bc-num-hours: 1 ]
  custom_queue:
    widget: 'select'
    label: "Queue or Reservation (-q)"
    options:
      <%- CustomQueues.queues["cr"].each do |queue| %>
      - [ "<%= queue.strip %>", "<%= queue.strip %>",
          data-exclusive-option-for-cluster-casper: true ]
      <%- end %>
      #- [ 'jhublogin', 'jhublogin',
       #    data-exclusive-option-for-resource-jhublogin: true
       #  ]
  bc_account:
    label: "Project Account (-A)"
    widget: 'select'
    help: "Select the account to charge for this job."
    options:
      # The session runs on Casper, so only Casper accounts. InferStudio
      # charges its inference jobs to the same account, on either system.
      <%- Array(CustomAccounts.accounts["cr"]).map(&:strip).uniq.each do |account| %>
      - [ "<%= account %>", "<%= account %>" ]
      <%- end %>
  num_nodes: 1
  bc_num_slots: 2
  threads: 1
  mpiprocs: 1
  memory: 128
  bc_num_hours:
    label: "Wall Time in hours (24-hour max)"
    widget: 'number_field'
    min: 1
    max: 24
    value: 1 # Default
  conda_env:
    label: "Conda Environment"
    widget: 'select'
    options:
      # The first entry is the default. InferStudio is creditJun3 cloned
      # with miles-credit upgraded to its latest release.
      - ["InferStudio", "/glade/work/pearse/conda-envs/InferStudio"]
      - ["creditJun3", "/glade/work/pearse/conda-envs/creditJun3"]
